tifact they indict."}, {"id": "_claude_skills_speckit_checklist_skill_dynamic_clarify_questions", "label": "Dynamic Clarifying Question Generation", "file_type": "concept", "source_file": ".claude/skills/speckit-checklist/SKILL.md", "source_location": "Execution Steps 3", "source_url": null, "captured_at": null, "author": "github-spec-kit", "contributor": null, "rationale": "Up to three signal-derived questions (max five with escalation), never from a pre-baked catalog, and only where the answer materially changes checklist content."}], "edges": [{"source": "_claude_skills_speckit_checklist_skill_speckit_checklist", "target": "_specify_memory_constitution_project_constitution", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/speckit-checklist/SKILL.md", "source_location": "Execution Steps 2", "weight": 1.0}, {"source": "_claude_skills_speckit_checklist_skill_speckit_checklist", "target": "_specify_templates_checklist_template_checklist_template", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/speckit-checklist/SKILL.md", "source_location": "Execution Steps 7: canonical template", "weight": 1.0}, {"source": "_claude_skills_speckit_checklist_skill_speckit_checklist", "target": "_claude_skills_speckit_analyze_skill_check_prerequisites_sh", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/speckit-checklist/SKILL.md", "source_location": "Execution Steps 1", "weight": 1.0}, {"source": "_claude_skills_speckit_checklist_skill_speckit_checklist", "target": "_claude_skills_speckit_analyze_skill_extension_hooks_protocol", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/speckit-checklist/SKILL.md", "source_location": "Pre/Post-Execution Checks", "weight": 1.0}, {"source": "_claude_skills_speckit_checklist_skill_speckit_checklist", "target