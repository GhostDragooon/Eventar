{"nodes": [{"id": "docs_plans_2026_07_10_cpd_sprint_3b_review_prep_external_voice_review", "label": "External-Voice Review going-in position", "file_type": "document", "source_file": "docs/plans/2026-07-10-cpd-sprint-3b-review-prep.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The one external review (one accrediting body, one organiser, one practitioner) that gates all of Sprint 3b; a good meeting makes the engine designable not designed."}, {"id": "docs_plans_2026_07_10_cpd_sprint_3b_review_prep_three_categories", "label": "Three Categories of Review Items", "file_type": "rationale", "source_file": "docs/plans/2026-07-10-cpd-sprint-3b-review-prep.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Body-dependent facts (ask), safe defaults (confirm), and open internal design the review informs but does not close (evaluator + retro-trust model); if category 3 is omitted from notes, review-done gets misread as 3b-unblocked."}, {"id": "docs_plans_2026_07_10_cpd_sprint_3b_review_prep_seven_questions", "label": "The Seven Review Questions (Q1-Q7)", "file_type": "concept", "source_file": "docs/plans/2026-07-10-cpd-sprint-3b-review-prep.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four confirmations (Q1 reviewers, Q2 confirmation, Q4 cross-body, Q6 storage grammar), three real body decisions (Q3 PDF, Q5 fork input, Q7 roster), one architecturally load-bearing (Q5)."}, {"id": "docs_plans_2026_07_10_cpd_sprint_3b_review_prep_q5_behavioural_framing", "label": "Q5 behavioural framing rule", "file_type": "rationale", "source_file": "docs/plans/2026-07-10-cpd-sprint-3b-review-prep.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The body cannot pick pinned-in-hash vs chained-version-tabl