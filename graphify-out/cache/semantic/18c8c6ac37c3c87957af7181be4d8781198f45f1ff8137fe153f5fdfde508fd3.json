{"nodes": [{"id": "docs_plans_2026_05_17_eventar_phase_1_5b_form_redesign", "label": "Phase 1.5b \u2014 New-event form redesign (design doc)", "file_type": "document", "source_file": "docs/plans/2026-05-17-eventar-phase-1.5b-form-redesign.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plans_2026_05_17_form_redesign_accordion_pattern", "label": "Accordion-over-wizard navigation rationale", "file_type": "rationale", "source_file": "docs/plans/2026-05-17-eventar-phase-1.5b-form-redesign.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User wanted freedom to fill sections in any order; a wizard's strict gating would force a back-button cascade that complicates state. Accordion with per-section Done buttons (no auto-collapse on blur) gives the right level of structure without surprise behaviour."}, {"id": "docs_plans_2026_05_17_form_redesign_mapbox_hk_bias_rationale", "label": "Mapbox HK proximity-bias rationale", "file_type": "rationale", "source_file": "docs/plans/2026-05-17-eventar-phase-1.5b-form-redesign.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "proximity (Victoria Harbour lng/lat) is the single highest-leverage knob to surface HK landmarks like HKCEC without restricting matches; no country filter preserves global fallback for non-HK addresses."}], "edges": [{"source": "docs_plans_2026_05_17_eventar_phase_1_5b_form_redesign", "target": "docs_plans_2026_05_17_form_redesign_accordion_pattern", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/plans/2026-05-17-eventar-phase-1.5b-form-redesign.md", "source_location": null, "weight": 1.0}, {"source": "docs_plans_2026_05_17_eventar_phase_1_5b_form_redesign", "target": "docs_plans_2026_05_17_form_redesign_mapbox_hk_bias_rationale", "relat