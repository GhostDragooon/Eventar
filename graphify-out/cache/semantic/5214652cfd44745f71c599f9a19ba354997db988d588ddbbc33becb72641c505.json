{"nodes": [{"id": "docs_plans_handoff_02082026_handoff_02082026", "label": "Handoff 2026-08-02 \u2014 M2 frontend unfreeze Stages 1\u20133", "file_type": "document", "source_file": "docs/plans/handoff_02082026.md", "source_location": "L1-L110", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plans_handoff_02082026_three_framing_corrections", "label": "Ivan's three framing corrections", "file_type": "rationale", "source_file": "docs/plans/handoff_02082026.md", "source_location": "L9-L23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "(1) the artifact is the real frontend, not a mockup; (2) a grep showed nothing in the app read or wrote accrediting_body_id / cpd_hours \u2014 a CPD platform where no organiser could accredit an event; (3) external validation is an injection point, not a blocker. The session's real content is being wrong three times about what the work was."}, {"id": "docs_plans_handoff_02082026_wcag_aa_regression", "label": "WCAG AA regression from adopting #0E79EC for CTAs", "file_type": "concept", "source_file": "docs/plans/handoff_02082026.md", "source_location": "L50", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every primary button went 4.55:1 (passing) \u2192 4.23:1 (failing); fixed to #1C3C94 = 9.89:1."}, {"id": "docs_plans_handoff_02082026_token_value_without_role", "label": "Adopting a token's value without its role", "file_type": "rationale", "source_file": "docs/plans/handoff_02082026.md", "source_location": "L50", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The app used ONE blue for everything; the locked design is a ramp with roles. Taking the values without the role separation silently downgrades contrast \u2014 the spec even said #0E79EC is 'not small text'."}, {"id": "docs_plans_handoff_02082026_new_event_form_flake", "label": "NewEventForm flake root-caused after 7 occurrences", "file_type": "concept", "source_file": "docs/plans/handoff_02082026.md", "source_location": "L58", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The test's own comment claimed it waited for the button to re-enable; findByRole resolves on element existence, and the button is merely disabled={pending} mid-transition, so under load the second click hit a dead button."}, {"id": "docs_plans_handoff_02082026_security_invoker_correction", "label": "create/update_event_with_blocks are SECURITY INVOKER, not DEFINER", "file_type": "rationale", "source_file": "docs/plans/handoff_02082026.md", "source_location": "L71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Migration 20260725144446's comment asserts the edit path is a definer RPC running as the owner. It is not. The migration's conclusion survives only because it re-granted column-level UPDATE on every other column. Building on that comment produces a broken feature."}, {"id": "docs_plans_handoff_02082026_verified_not_active", "label": "Good standing is status='verified', never 'active'", "file_type": "rationale", "source_file": "docs/plans/handoff_02082026.md", "source_location": "L73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The same mistake already required corrective migration 20260724170650."}], "edges": [{"source": "docs_plans_handoff_02082026_handoff_02082026", "target": "docs_plans_handoff_01082026_handoff_01082026", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/plans/handoff_02082026.md", "source_location": "L11-L13", "weight": 1.0}, {"source": "docs_plans_handoff_02082026_three_framing_corrections", "target": "docs_plans_handoff_01082026_design_artifact_full_frontend", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/plans/handoff_02082026.md"