{"nodes": [{"id": "_claude_skills_speckit_analyze_skill_speckit_analyze", "label": "speckit-analyze", "file_type": "document", "source_file": ".claude/skills/speckit-analyze/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "github-spec-kit", "contributor": null}, {"id": "_claude_skills_speckit_analyze_skill_read_only_constraint", "label": "Read-Only Analysis Constraint", "file_type": "rationale", "source_file": ".claude/skills/speckit-analyze/SKILL.md", "source_location": "Operating Constraints", "source_url": null, "captured_at": null, "author": "github-spec-kit", "contributor": null, "rationale": "Analysis must never mutate spec/plan/tasks so that rerunning it is safe and deterministic; remediation is offered but requires explicit user approval before any editing command runs."}, {"id": "_claude_skills_speckit_analyze_skill_constitution_authority", "label": "Constitution Authority", "file_type": "rationale", "source_file": ".claude/skills/speckit-analyze/SKILL.md", "source_location": "Operating Constraints", "source_url": null, "captured_at": null, "author": "github-spec-kit", "contributor": null, "rationale": "The constitution is non-negotiable inside analysis scope: a conflict forces the spec/plan/tasks to change, never the principle. Changing a principle must happen in a separate explicit constitution update so governance cannot be diluted by implementation pressure."}, {"id": "_claude_skills_speckit_analyze_skill_severity_rubric", "label": "Analysis Severity Rubric (CRITICAL/HIGH/MEDIUM/LOW)", "file_type": "concept", "source_file": ".claude/skills/speckit-analyze/SKILL.md", "source_location": "Execution Steps 5", "source_url": null, "captured_at": null, "author": "github-spec-kit", "contributor": null}, {"id": "_claude_skills_speckit_analyze_skill_detection_passes", "label": "Cross-Artifact Detection Passes", "file_type": "concept", "source_file": ".claude/skills/speckit-analyze/SKILL.md", "source_location": "Execution Steps 4", "source_url": null, "captured_at": null, "author": "github-spec-kit", "contributor": null, "rationale": "Six passes (duplication, ambiguity, underspecification, constitution alignment, coverage gaps, inconsistency) capped at 50 findings, to keep output high-signal instead of exhaustive."}, {"id": "_claude_skills_speckit_analyze_skill_requirements_inventory", "label": "Requirements Inventory (FR-###/SC-### stable keys)", "file_type": "concept", "source_file": ".claude/skills/speckit-analyze/SKILL.md", "source_location": "Execution Steps 3", "source_url": null, "captured_at": null, "author": "github-spec-kit", "contributor": null, "rationale": "Success Criteria are filtered to items requiring buildable work; post-launch outcome metrics and business KPIs are excluded so coverage percentages are not diluted by things no task can implement."}, {"id": "_claude_skills_speckit_analyze_skill_progressive_disclosure", "label": "Progressive Disclosure Artifact Loading", "file_type": "concept", "source_file": ".claude/skills/speckit-analyze/SKILL.md", "source_location": "Execution Steps 2 / Operating Principles", "source_url": null, "captured_at": null, "author": "github-spec-kit", "contributor": null}, {"id": "_claude_skills_speckit_analyze_skill_extension_hooks_protocol", "label": "Extension Hooks Protocol (.specify/extensions.yml)", "file_type": "concept", "source_file": ".claude/skills/speckit-analyze/SKILL.md", "source_location": "Pre-Execution Checks / Step 9", "source_url": null, "captured_at": null, "author": "github-spec-kit", "contributor": null, "rationale": "Uniform before_/after_ hook contract shared by every speckit command: hooks default to enabled, condition expressions are deliberately NOT evaluated by the agent (left to the HookExecutor), and dotted command ids are rewritten to hyphens when constructing slash commands."}, {"id": "_claude_skills_speckit_analyze_skill_check_prerequisites_sh", "label": "check-prerequisites.sh", "file_type": "code", "source_