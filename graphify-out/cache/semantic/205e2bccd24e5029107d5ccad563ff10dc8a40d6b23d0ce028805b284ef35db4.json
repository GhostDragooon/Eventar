{"nodes": [{"id": "_claude_skills_speckit_specify_skill_speckit_specify", "label": "speckit-specify", "file_type": "document", "source_file": ".claude/skills/speckit-specify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "github-spec-kit", "contributor": null}, {"id": "_claude_skills_speckit_specify_skill_short_name_generation", "label": "Feature Short-Name Generation", "file_type": "concept", "source_file": ".claude/skills/speckit-specify/SKILL.md", "source_location": "Outline step 1", "source_url": null, "captured_at": null, "author": "github-spec-kit", "contributor": null}, {"id": "_claude_skills_speckit_specify_skill_feature_directory_resolution", "label": "SPECIFY_FEATURE_DIRECTORY Resolution", "file_type": "concept", "source_file": ".claude/skills/speckit-specify/SKILL.md", "source_location": "Outline step 3", "source_url": null, "captured_at": null, "author": "github-spec-kit", "contributor": null, "rationale": "Spec directory name and git branch name are deliberately independent. Prefix comes from init-options.json feature_numbering (sequential NNN or timestamp); branch_numbering is deprecated and warns on use."}, {"id": "_claude_skills_speckit_specify_skill_feature_json", "label": ".specify/feature.json Handoff Record", "file_type": "concept", "source_file": ".claude/skills/speckit-specify/SKILL.md", "source_location": "Outline step 3", "source_url": null, "captured_at": null, "author": "github-spec-kit", "contributor": null, "rationale": "Persisting the resolved feature directory lets downstream commands locate it without relying on git branch-name conventions."}, {"id": "_claude_skills_speckit_specify_skill_needs_clarification_limit", "label": "Max 3 NEEDS CLARIFICATION Markers", "file_type": "rationale", "source_file": ".claude/skills/speckit-specify/SKILL.md", "source_location": "Outline step 6 / For AI Generation", "source_url": null, "captured_at": null, "author": "github-spec-kit", "contributor": null, "rationale": "Make informed guesses and document them as Assumptions; reserve markers for choices with no reasonable default, prioritised scope > security/privacy > UX > technical detail. Caps interrogation of the user at three questions."}, {"id": "_claude_skills_speckit_specify_skill_spec_quality_checklist", "label": "Spec Quality Checklist (checklists/requirements.md)", "file_type": "document", "source_file": ".claude/skills/speckit-specify/SKILL.md", "source_location": "Outline step 7a", "source_url": null, "captured_at": null, "author": "github-spec-kit", "contributor": null, "rationale": "Three gates \u2014 Content Quality, Requirement Completeness, Feature Readiness \u2014 re-run up to three iterations; remaining failures are documented in checklist notes and warned about rather than silently passed."}, {"id": "_claude_skills_speckit_specify_skill_success_criteria_guidelines", "label": "Technology-Agnostic Success Criteria", "file_type": "rationale", "source_file": ".claude/skills/speckit-specify/SKILL.md", "source_location": "Success Criteria Guidelines", "source_url": null, "captured_at": null, "author": "github-spec-kit", "contributor": null, "rationale": "Criteria must be measurable, user-focused and verifiable without implementation knowledge; 'API response under 200ms' and 'Redis cache hit rate above 80%' are rejected in favour of user-facing equivalents so the spec stays stack-neutral."}], "edges": [{"source": "_claude_skills_speckit_specify_skill_speckit_specify", "target": "_claude_skills_speckit_clarify_skill_speckit_clarify", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/speckit-specify/SKILL.md", "source_location": "Completion Report", "weight": 1.0}, {"source": "_claude_skills_speckit_specify_skill_speckit_specify", "target": "_claude_skills_speckit_plan_skill_speckit_plan", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/speckit-sp