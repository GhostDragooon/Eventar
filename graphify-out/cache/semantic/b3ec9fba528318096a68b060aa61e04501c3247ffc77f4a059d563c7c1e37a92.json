{"nodes": [{"id": "docs_plans_project_state_overview", "label": "Project State \u2014 Eventar", "file_type": "document", "source_file": "docs/plans/PROJECT_STATE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plans_project_state_q32_audience_boundary", "label": "Q32 audience boundary (attendee vs organizer doors)", "file_type": "rationale", "source_file": "docs/plans/PROJECT_STATE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two audiences never cross doors: attendee sign-in is /account/sign-in with homes /events and /account; organizer sign-in is /login with homes /dashboard and /dashboard/manage. StaffShell never links public /events; attendee shells never point auth CTA at /login."}, {"id": "docs_plans_project_state_stage10_dashboard_split", "label": "Stage 10 dashboard route split (Programme + Manage)", "file_type": "concept", "source_file": "docs/plans/PROJECT_STATE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plans_project_state_auth_callback_audit", "label": "2026-09-09 attendee/organizer split audit", "file_type": "rationale", "source_file": "docs/plans/PROJECT_STATE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "System-wide audit found codebase mostly correct; fixed /auth/callback error redirects to derive destination from ?next= (including /events/ prefix, missed by first pass) and closed a soft-loop on /account/sign-in for a staff session with no matching users row."}, {"id": "docs_plans_project_state_organiser_programme_home", "label": "Organiser programme home rebuild (/dashboard Luma-referenced layout)", "file_type": "concept", "source_file": "docs/plans/PROJECT_STATE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "