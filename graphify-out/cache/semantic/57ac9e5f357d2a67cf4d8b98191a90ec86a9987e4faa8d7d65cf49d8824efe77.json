{"nodes": [{"id": "docs_plans_2026_05_13_eventar_mvp_design", "label": "Eventar MVP Design (2026-05-13)", "file_type": "document", "source_file": "docs/plans/2026-05-13-eventar-mvp-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plans_2026_05_13_eventar_mvp_design_email_log_pattern", "label": "email_log insert-before-send idempotency pattern", "file_type": "rationale", "source_file": "docs/plans/2026-05-13-eventar-mvp-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Insert email_log row BEFORE sending via Resend. Reversed order risks duplicates if the process crashes between send and log; the 'miss one' failure mode is recoverable (manual re-send) while 'send twice' undermines trust \u2014 asymmetric cost drives the ordering choice."}, {"id": "docs_plans_2026_05_13_eventar_mvp_design_require_staff_helper", "label": "requireStaff() load-bearing helper (design)", "file_type": "rationale", "source_file": "docs/plans/2026-05-13-eventar-mvp-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns {id, role, email} for the logged-in staff user or throws 401; every staff Server Action begins with this call. Written once with full tests in phase 1, not touched again until MS-SSO migration."}], "edges": [{"source": "docs_plans_2026_05_13_eventar_mvp_design", "target": "docs_plans_2026_05_13_eventar_mvp_design_email_log_pattern", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/plans/2026-05-13-eventar-mvp-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_plans_2026_05_13_eventar_mvp_design", "target": "docs_plans_2026_05_13_eventar_mvp_design_require_staff_helper", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "s