 "app_events_id_checkin_page_rosterclient", "label": "RosterClient component (staff tablet check-in)", "file_type": "code", "source_file": "docs/plans/2026-05-22-eventar-phase-4-checkin-design.md", "source_location": "app/events/[id]/checkin/RosterClient.tsx", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plans_phase4_checkin_idempotent_update_pattern", "label": "Idempotent UPDATE ... WHERE status != 'attended' race-safety pattern", "file_type": "rationale", "source_file": "docs/plans/2026-05-22-eventar-phase-4-checkin-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "markAttended and selfCheckIn both UPDATE ... WHERE registration_code = code AND status != 'attended', returning 0 rows on a race between staff-tablet and self-checkin or duplicate scans. Surfacing the 0-row case as a distinct 'already attended' error rather than reporting fake success follows the fail-visibly rule (CLAUDE.md rule 12)."}, {"id": "docs_plans_phase4_cross_event_scan_decision", "label": "Cross-event scan tolerance decision", "file_type": "rationale", "source_file": "docs/plans/2026-05-22-eventar-phase-4-checkin-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "markAttended does not require the staff member to own the event whose code was scanned, so a manager running check-in for multiple concurrent events from one tablet doesn't get spurious failures; the success toast shows the event title, making cross-event scans visible rather than silently blocked."}], "edges": [{"source": "docs_plans_2026_05_22_eventar_phase_4_checkin_design", "target": "docs_plans_phase4_checkin_columns_migration", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/plans/2026-05-22-eventar-phase-4-checkin-design.md", "source_location": null, "weight": 1.0}, {"source":