{"nodes": [{"id": "docs_plans_2026_07_12_market_realignment_market_realignment", "label": "Market Realignment analysis", "file_type": "document", "source_file": "docs/plans/2026-07-12-market-realignment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Maps what a production-grade CPD/event platform is expected to do (competitor teardown + 12 body documents + UI refs) vs what Eventar is building; sharpens the review and stocks the post-review backlog, must not become a reason to build ahead of validation."}, {"id": "docs_plans_2026_07_12_market_realignment_competitor_cpd_passport", "label": "Competitor CPD Passport", "file_type": "concept", "source_file": "docs/plans/2026-07-12-market-realignment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Manual entry + certificate upload + lock-flag with admin override + self-report with 30-working-day third-party verification; structural weaknesses Eventar beats with first-party attendance and a tamper-evident chain."}, {"id": "docs_plans_2026_07_12_market_realignment_external_activities_evidence_locker", "label": "External activities + evidence locker", "file_type": "concept", "source_file": "docs/plans/2026-07-12-market-realignment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The gap between an event-attendance tool and a CPD platform (the backfill/new-joiner mechanism); manual entry with per-body taxonomies + Supabase Storage evidence (retention per body) + a verification-tier field so external entries coexist without diluting the chain."}, {"id": "docs_plans_2026_07_12_market_realignment_verification_tiers", "label": "Verification tiers (attendance_verified/organiser_attested/self_declared)", "file_type": "concept", "source_file": "docs/plans/2026-07-12-market-realignment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A per-entry trust field so scanned-at-venue credits keep the strongest tier and the evaluator applies tier-aware caps (e.g. self-study ceilings)."}, {"id": "docs_plans_2026_07_12_market_realignment_session_level_model", "label": "Session-level model (multi-track/per-session)", "file_type": "concept", "source_file": "docs/plans/2026-07-12-market-realignment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Matters specifically if the pilot event is a conference (multi-room, per-hour points); two phases - cheap schema readiness now, full multi-track UI post-M4. Ivan call: what shape is the intended pilot event."}, {"id": "docs_plans_2026_07_12_market_realignment_verify_record_url", "label": "Verify-this-record public URL", "file_type": "concept", "source_file": "docs/plans/2026-07-12-market-realignment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The hash-registry lookup page (paste/scan a record ref to chain-verified); nearly free given the registry, converts the integrity story into something a body clerk can touch. Explicit S4 deliverable."}, {"id": "docs_plans_2026_07_12_market_realignment_calendar_links", "label": "Calendar links (.ics/Google/Outlook)", "file_type": "concept", "source_file": "docs/plans/2026-07-12-market-realignment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Designed pre-pivot (lib/calendarLinks.ts), never built; backend-only email template addition, freeze-safe; candidate for demo-pack polish week."}, {"id": "docs_plans_2026_07_12_market_realignment_walkin_handling", "label": "Walk-in handling at the door", "file_type": "concept", "source_file": "docs/plans/2026-07-12-market-realignment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Small design (staff-created registration inside TC), needed by any real event with door traffic; design note now, build at first trial feedback."}, {"id": "docs_plans_2026_07_12_market_realignment_online_cme_mcq_gate", "label": "Online-CME MCQ assessment gate", "file_type": "concept", "source_file": "docs/plans/2026-07-12-market-realignment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HKAM's iCMECPD requires QR capture plus MCQ completion for e-learning points; defer with a hard trigger (first online/hybrid accredited event), state as a scope boundary in the body-review script."}, {"id": "docs_plans_2026_07_12_market_realignment_cpd_ledger_naming_q29", "label": "CPD Ledger naming (Q29)", "file_type": "concept", "source_file": "docs/plans/2026-07-12-market-realignment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolved 2026-07-12: Eventar's module is the CPD Ledger; CPD Passport retired, reserved for the competitor (brand collision)."}, {"id": "docs_plans_2026_07_12_market_realignment_paid_ticketing_q21", "label": "Paid ticketing excluded (Q21)", "file_type": "concept", "source_file": "docs/plans/2026-07-12-market-realignment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately excluded; invoice-first billing is zero-code for pilot. Re-entry trigger: first organiser asks to charge attendees - then a payments decision, not a feature toggle."}, {"id": "docs_plans_2026_07_12_market_realignment_compliance_projection", "label": "Compliance projection (floors/caps/cycles)", "file_type": "concept", "source_file": "docs/plans/2026-07-12-market-realignment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rati