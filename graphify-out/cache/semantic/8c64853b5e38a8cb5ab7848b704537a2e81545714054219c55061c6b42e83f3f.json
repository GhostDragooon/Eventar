{"nodes": [{"id": "docs_doctrine_hard_rule_integrity_structural", "label": "Hard Rule: Integrity is structural; domain is configuration", "file_type": "rationale", "source_file": "docs/doctrine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any tamper-evidence/audit/actor-authenticity/append-only/tenancy/residency guarantee must be structural and unreachable by any config flag; domain-specific behaviour must be configuration data so new bodies onboard without a code change."}, {"id": "docs_doctrine_hard_rule_config_data_rowscaling", "label": "Hard Rule: Configuration is data; scaling is row-based", "file_type": "rationale", "source_file": "docs/doctrine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New bodies/organisers/cycles/roles are added as data rows, never new tables/columns/branches; if onboarding a body needs a migration or deploy, something configurable was hardwired. Hierarchy uses parent_body_id."}, {"id": "docs_doctrine_six_tier_classification", "label": "Six-tier hardwired-vs-configurable classification", "file_type": "rationale", "source_file": "docs/doctrine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_doctrine_interpretation_immutability", "label": "Interpretation-immutability (append-only versioned config)", "file_type": "rationale", "source_file": "docs/doctrine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_doctrine_bitemporal_separation", "label": "Bitemporal separation (valid-time vs transaction-time)", "file_type": "rationale", "source_file": "docs/doctrine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_doctrine_rfc_8785", "label": "RFC 8785 JSON canonicalization (never has