{"nodes": [{"id": "docs_plans_2026_07_10_cpd_sprint_3b_engine_design_engine_outline", "label": "CPD Sprint 3b Engine Outline", "file_type": "document", "source_file": "docs/plans/2026-07-10-cpd-sprint-3b-engine-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Covers the engine that turns attendance into compliant credits, the MVP critical path, double-gated on Q26 plus the external body review; exists so the engine is designable fast once gates lift."}, {"id": "docs_plans_2026_07_10_cpd_sprint_3b_engine_design_three_layer_open_framework", "label": "Three-Layer Open-Framework Line", "file_type": "rationale", "source_file": "docs/plans/2026-07-10-cpd-sprint-3b-engine-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Config/data layer fully open now; governance layer open interfaces with defaults; evaluator layer a bounded-grammar interpreter, NOT a general rules engine, extended on documented demand only."}, {"id": "docs_plans_2026_07_10_cpd_sprint_3b_engine_design_body_rules", "label": "body_rules versioned config DDL (E1)", "file_type": "concept", "source_file": "docs/plans/2026-07-10-cpd-sprint-3b-engine-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Append-only effective-dated rule versions (effective_from + version_seq, active derived by query); rule content ungated (verified vs 8 bodies), versioning mechanism Q26-shaped."}, {"id": "docs_plans_2026_07_10_cpd_sprint_3b_engine_design_body_cycles", "label": "body_cycles table (E1)", "file_type": "concept", "source_file": "docs/plans/2026-07-10-cpd-sprint-3b-engine-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plans_2026_07_10_cpd_sprint_3b_engine_design_deterministic_evaluator", "label": "Deterministic Evaluator evaluate_compliance() (E2)", "file_type": "concept", "source_file": "docs/plans/2026-07-10-cpd-sprint-3b-engine-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pure deterministic function projecting a licence's ledger against the body_rules version in force at each entry's valid_domain_time; no AI, no mutation; the single largest unbuilt engine unknown."}, {"id": "docs_plans_2026_07_10_cpd_sprint_3b_engine_design_bounded_grammar_interpreter", "label": "Bounded-Grammar Interpreter discipline", "file_type": "rationale", "source_file": "docs/plans/2026-07-10-cpd-sprint-3b-engine-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Evaluator interprets a fixed grammar (floors/caps/cores/units/cycle windows), not arbitrary logic; a body needing logic outside the grammar gets the grammar extended to their documented rule, not a configurable engine."}, {"id": "docs_plans_2026_07_10_cpd_sprint_3b_engine_design_hkcr_stress_test", "label": "HKCR 16-subtype passive/active cap stress test", "file_type": "concept", "source_file": "docs/plans/2026-07-10-cpd-sprint-3b-engine-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Storing 16 activity types is trivial; the evaluator must compute a passive/active cap aggregated across them under the rule version in force at each date; if it handles HKCR it handles the eight verified bodies."}, {"id": "docs_plans_2026_07_10_cpd_sprint_3b_engine_design_q26_config_hash_fork", "label": "Q26 Config-Hash Fork", "file_type": "concept", "source_file": "docs/plans/2026-07-10-cpd-sprint-3b-engine-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pinned-in-hash vs chained-version-table; decided from one behavioural fact (how a body handles mid-cycle rule changes); the single gate that unblocks E1-versioning, E5 and E2 in sequence."}, {"id": "docs_plans_2026_07_10_cpd_sprint_3b_engine_design_q27_evaluator_versioning", "label": "Q27 Evaluator-Versioning", "file_type": "concept", "source_file": "docs/plans/2026-07-10-cpd-sprint-3b-engine-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For a reproducible historical verdict the evaluator's own version (release tag/code hash) must be pinnable alongside the config version; decide when the first verdict is exported."}, {"id": "docs_plans_2026_07_10_cpd_sprint_3b_engine_design_rfc_8785", "label": "RFC 8785 canonical serialization", "file_type": "concept", "source_file": "docs/plans/2026-07-10-cpd-sprint-3b-engine-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Applied before any config hash regardless of which Q26 arm wins; both arms hash canonicalized config, only where differs."}, {"id": "docs_plans_2026_07_10_cpd_sprint_3b_engine_design_bitemporal_evaluation", "label": "Bitemporal rule-version evaluation (valid_domain_time)", "file_type": "concept", "source_file": "docs/plans/2026-07-10-cpd-sprint-3b-engine-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A December activity is judged under December's rules even if evaluated in March."}, {"id": "docs_plans_2026_07_10_cpd_sprint_3b_engine_design_issuance", "label": "Issuance: attendance x rules to ledger entries (E3)", "file_type": "concept", "source_file": "docs/plans/2026-07-10-cpd-sprint-3b-engine-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On published-to-credited transition a deterministic job reads attendance x the body_rules version in force and writes credit_earned via record_credit_entry; store all credits incl. unmatched-body cases, filter in a view, never drop silently."}, {"id": "docs_plans_2026_07_10_cpd_sprint_3b_engine_design_record_credit_entry", "label": "record_credit_entry writer (service_role-only definer)", "file_type": "code", "source_file": "docs/plans/2026-07-10-cpd-sprint-3b-engine-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plans_2026_07_10_cpd_sprint_3b_engine_design_adr_0015_store_filter_view", "label": "ADR 0015 store-all-filter-in-view", "file_type": "concept", "source_file": "docs/plans/2026-07-10-cpd-sprint-3b-engine-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plans_2026_07_10_cpd_sprint_3b_engine_design_roster_ingestion", "label": "Roster ingestion + verification badges (E4)", "file_type": "concept", "source_file": "docs/plans/2026-07-10-cpd-sprint-3b-engine-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Self-declared-until-roster is the correct default; verification is an additive trust signal not a tamper surface; an unverified licence is flagged, never blocked. Gated on Q7 (does the pilot body provide a roster)."}, {"id": "docs_plans_2026_07_10_cpd_sprint_3b_engine_design_roster_uploads", "label": "roster_uploads / body_members tables", "file_type": "concept", "source_file": "docs/plans/2026-07-10-cpd-sprint-3b-engine-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plans_2026_07_10_cpd_sprint_3b_engine_design_retroactive_trust_upgrade", "label": "Retroactive-Trust-Upgrade Model (E5)", "file_type": "concept", "source_file": "docs/plans/2026-07-10-cpd-sprint-3b-engine-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One problem, three instances (event confirmation, licence verification, future signals); three candidate mechanisms (leave-pinned, append credit_adjusted, project trust at query time), each with a real cost; coupled to Q26 because the clean answer differs by arm."}, {"id": "docs_plans_2026_07_10_cpd_sprint_3b_engine_design_credit_adjusted", "label": "credit_adjusted append mechanism", "file_type": "concept", "source_file": "docs/plans/2026-07-10-cpd-sprint-3b-engine-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_plans_2026_07_10_cpd_sprint_3b_engine_design_engine_outline", "target": "docs_plans_2026_07_10_cpd_sprint_3b_engine_design_body_rules", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/plans/2026-07-10-cpd-sprint-3b-engine-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_plans_2026_07_10_cpd_sprint_3b_engine_design_engine_outline", "target": "docs_plans_2026_07_10_cpd_sprint_3b_engine_design_body_cycles", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/plans/2026-07-10-cpd-sprint-3b-engine-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_plans_2026_07_10_cpd_sprint_3b_engine_design_engine_outline", "target": "docs_plans_2026_07_10_cpd_sprint_3b_engine_design_deterministic_evaluator", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/plans/2026-07-10-cpd-sprint-3b-engine-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_plans_2026_07_10_cpd_sprint_3b_engine_design_engine_outline", "target": "docs_plans_2026_07_10_cpd_sprint_3b_engine_design_issuance", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/plans/2026-07-10-cpd-sprint-3b-engine-design.md", "source_location": null, "weight": 1.0